{
  "meta": {
    "name": "RESQNET Drone Configuration",
    "version": "2.0",
    "supersedes": "1.0",
    "contract_version": "1.0",
    "linked_files": [
      "disaster_scenarios.json",
      "failure_scenarios.json"
    ],
    "coordinate_system": "origin top-left; x = column 0-19 (left to right); y = row 0-19 (top to bottom); cell label = column letter A-T + row number 1-20 (x=1,y=3 -> B4)",
    "units": {
      "speed": "cells per tick (and m/s)",
      "tick_s": 2,
      "cell_size_m": 25,
      "battery": "percent of full charge",
      "drain": "percent per tick"
    },
    "drone_status_values": [
      "idle",
      "searching",
      "disconnected",
      "recovering",
      "returning"
    ],
    "modes": [
      "centralized",
      "decentralized",
      "hybrid"
    ],
    "assumptions": [
      "Speeds, drain rates and ranges are initial test values, not real flight specifications.",
      "Battery use per tick = drain_pct_per_tick[activity].",
      "A drone should return home when battery <= return_threshold_pct, or when battery <= distance_to_base_cells * drain_moving * 1.2.",
      "Below critical_pct the drone stops and is treated as unable to continue.",
      "A drone reaches the controller if within hub range, or through a chain of peers within comm_range_cells (relay drones extend this)."
    ]
  },
