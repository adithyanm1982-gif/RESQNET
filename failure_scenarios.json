{
  "meta": {
    "name": "RESQNET Failure Scenarios",
    "version": "2.0",
    "supersedes": "1.0",
    "contract_version": "1.0",
    "linked_files": [
      "disaster_scenarios.json",
      "drone_config.json"
    ],
    "coordinate_system": "origin top-left; x = column 0-19 (left to right); y = row 0-19 (top to bottom); cell label = column letter A-T + row number 1-20 (x=1,y=3 -> B4)",
    "units": {
      "time": "seconds from mission start",
      "mission_duration_s": 600,
      "tick_s": 2,
      "delay": "milliseconds",
      "loss": "percent of packets"
    },
    "modes": [
      "centralized",
      "decentralized",
      "hybrid"
    ],
    "drone_ids": [
      "D1",
      "D2",
      "D3",
      "D4",
      "D5",
      "D6"
    ],
    "message_types": [
      "heartbeat",
      "task_assignment",
      "task_claim",
      "position_update",
      "status_report",
      "state_sync"
    ],
    "event_types": {
      "controller_outage": "Central controller unavailable between start_s and end_s",
      "drone_unresponsive": "A drone stops responding (status disconnected); end_s null means it never returns",
      "network_partition": "Drones split into groups; only the group with has_controller_link reaches the controller; connectivity returns at end_s",
      "packet_loss": "Messages dropped for the stated scope",
      "message_delay": "Extra latency, jitter, reordering and duplicates",
      "battery_override": "Replace initial battery of listed drones at start",
      "no_fly_activation": "Cells become restricted at start_s (cells_by_scenario)"
    },
    "event_status_values": [
      "scheduled",
      "active",
      "recovering",
      "resolved"
    ],
    "recovery_model": "After a fault ends, wait reconnect_delay_s, then resync_time_s to reconcile task state; total_recovery_s is the sum.",
    "baseline_network_note": "Baseline packet loss, latency and reliability per map are in disaster_scenarios.json communication.conditions.",
    "heartbeat": {
      "interval_s": 2,
      "timeout_s": 6,
      "missed_before_failover": 3
    },
    "fairness_rule": "For one run_id, all three modes use the same map, tasks, starting positions and failure schedule. Seeds are recorded; report results even when hybrid performs worse.",
    "synthetic_data_notice": "All values are initial test parameters, not real-world operating specifications."
  },
  "failure_scenarios": [
    {
      "failure_scenario_id": "normal_operation",
      "title": "Normal Operation",
      "description": "No injected failures; baseline coordination.",
      "tests": "Baseline task allocation and coverage",
      "seed_offset": 0,
      "expected_checks": [
        "All tasks allocated without duplicates",
        "Coverage reaches a stable baseline"
      ],
      "events": []
    },
    {
      "failure_scenario_id": "controller_failure",
      "title": "Controller Failure",
      "description": "Central controller becomes unavailable and later returns.",
      "tests": "Whether local recovery resumes useful progress",
      "seed_offset": 1,
      "expected_checks": [
        "Drones keep making progress during the outage",
        "Task state is reconciled after the controller returns"
      ],
      "events": [
        {
          "id": "E01",
          "type": "controller_outage",
          "start_s": 120,
          "end_s": 300,
          "target": "central_controller",
          "severity": "full",
          "cause": "power_failure",
          "reconnection": {
            "detect_timeout_s": 6,
            "reconnect_delay_s": 6,
            "resync_time_s": 8,
            "total_recovery_s": 14,
            "state_sync": "delta"
          },
          "status": "scheduled",
          "duration_s": 180
        }
      ]
    },
    {
      "failure_scenario_id": "drone_failure",
      "title": "Drone Failure",
      "description": "Drone D3 stops responding and does not come back.",
      "tests": "Whether abandoned tasks are recovered",
      "seed_offset": 2,
      "expected_checks": [
        "Tasks owned by D3 are detected as abandoned",
        "Another drone takes them over"
      ],
      "events": [
        {
          "id": "E01",
          "type": "drone_unresponsive",
          "start_s": 150,
          "end_s": null,
          "drone_id": "D3",
          "recovers": false,
          "cause": "hardware_fault",
          "status": "scheduled"
        }
      ]
    },
    {
      "failure_scenario_id": "network_partition",
      "title": "Network Partition",
      "description": "Drones split into two groups; only group A reaches the controller.",
      "tests": "Whether conflicting or stale task claims are handled",
      "seed_offset": 3,
      "expected_checks": [
        "No task is worked by two drones after the partition heals",
        "Stale claims are detected"
      ],
      "events": [
        {
          "id": "E01",
          "type": "network_partition",
          "start_s": 180,
          "end_s": 330,
          "cause": "interference",
          "groups": [
            {
              "group_id": "A",
              "drone_ids": [
                "D1",
                "D2",
                "D3"
              ],
              "has_controller_link": true
            },
            {
              "group_id": "B",
              "drone_ids": [
                "D4",
                "D5",
                "D6"
              ],
              "has_controller_link": false
            }
          ],
          "reconnection": {
            "detect_timeout_s": 6,
            "reconnect_delay_s": 8,
            "resync_time_s": 12,
            "total_recovery_s": 20,
            "state_sync": "delta"
          },
          "status": "scheduled",
          "duration_s": 150
        }
      ]
    },
    {
      "failure_scenario_id": "reconnection",
      "title": "Reconnection",
      "description": "Long three-way partition that forces diverging task claims before connectivity returns.",
      "tests": "Whether task states converge and the dashboard updates",
      "seed_offset": 4,
      "expected_checks": [
        "Task state converges after reconnection",
        "Duplicate or conflicting ownership is flagged and resolved",
        "Dashboard shows the reconciliation"
      ],
      "events": [
        {
          "id": "E01",
          "type": "network_partition",
          "start_s": 120,
          "end_s": 360,
          "cause": "interference",
          "groups": [
            {
              "group_id": "A",
              "drone_ids": [
                "D1",
                "D2"
              ],
              "has_controller_link": true
            },
            {
              "group_id": "B",
              "drone_ids": [
                "D3",
                "D4"
              ],
              "has_controller_link": false
            },
            {
              "group_id": "C",
              "drone_ids": [
                "D5",
                "D6"
              ],
              "has_controller_link": false
            }
          ],
          "reconnection": {
            "detect_timeout_s": 6,
            "reconnect_delay_s": 8,
            "resync_time_s": 12,
            "total_recovery_s": 20,
            "state_sync": "delta"
          },
          "reconciliation_check": {
            "expect_conflicting_claims": true,
            "convergence_deadline_s_after_reconnect": 30
          },
          "status": "scheduled",
          "duration_s": 240
        }
      ]
    },
    {
      "failure_scenario_id": "multiple_failures",
      "title": "Multiple Failures",
      "description": "Overlapping controller outage, drone failure, packet loss, delay and partition.",
      "tests": "Limits of the recovery design",
      "seed_offset": 5,
      "expected_checks": [
        "System degrades gracefully",
        "Failures to recover are reported honestly in the results"
      ],
      "events": [
        {
          "id": "E01",
          "type": "controller_outage",
          "start_s": 100,
          "end_s": 260,
          "target": "central_controller",
          "severity": "full",
          "cause": "power_failure",
          "reconnection": {
            "detect_timeout_s": 6,
            "reconnect_delay_s": 6,
            "resync_time_s": 8,
            "total_recovery_s": 14,
            "state_sync": "delta"
          },
          "status": "scheduled",
          "duration_s": 160
        },
        {
          "id": "E02",
          "type": "drone_unresponsive",
          "start_s": 140,
          "end_s": null,
          "drone_id": "D2",
          "recovers": false,
          "cause": "hardware_fault",
          "status": "scheduled"
        },
        {
          "id": "E03",
          "type": "packet_loss",
          "start_s": 180,
          "end_s": 300,
          "scope": "drones",
          "drone_ids": [
            "D4",
            "D5"
          ],
          "loss_pct": 35,
          "pattern": "burst",
          "burst_len_packets": 4,
          "affected_message_types": [
            "heartbeat",
            "task_assignment",
            "task_claim",
            "position_update",
            "status_report",
            "state_sync"
          ],
          "status": "scheduled",
          "duration_s": 120
        },
        {
          "id": "E04",
