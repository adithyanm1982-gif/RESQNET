          "end_s": 320,
          "scope": "global",
          "base_delay_ms": 1500,
          "jitter_ms": 600,
          "max_delay_ms": 4000,
          "reorder_probability": 0.05,
          "duplicate_probability": 0.02,
          "affected_message_types": [
            "heartbeat",
            "task_assignment",
            "task_claim",
            "position_update",
            "status_report",
            "state_sync"
          ],
          "status": "scheduled",
          "duration_s": 120
        },
        {
          "id": "E05",
          "type": "network_partition",
          "start_s": 280,
          "end_s": 420,
          "cause": "interference",
          "groups": [
            {
              "group_id": "A",
              "drone_ids": [
                "D1",
                "D2",
                "D3",
                "D4"
              ],
              "has_controller_link": true
            },
            {
              "group_id": "B",
              "drone_ids": [
                "D5",
                "D6"
              ],
              "has_controller_link": false
            }
          ],
          "reconnection": {
            "detect_timeout_s": 6,
            "reconnect_delay_s": 8,
            "resync_time_s": 12,
            "total_recovery_s": 20,
            "state_sync": "delta"
          },
          "status": "scheduled",
          "duration_s": 140
        }
      ]
    },
    {
